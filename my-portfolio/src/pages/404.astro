---
import Layout from "../layouts/Layout.astro";
---
<Layout title="404 — Page Not Found">
  <section class="container-narrow text-center" style="padding: 8rem 0;">
    <p class="eyebrow" style="justify-content:center;">404</p>
    <h1 style="font-size: clamp(2rem,5vw,3rem);">This page doesn't exist.</h1>
    <p class="section-sub" style="margin-inline:auto;">The page you're looking for was moved or never existed.</p>
    <a href="/" class="btn btn-primary">Back to Home</a>
  </section>
</Layout>
