---
export interface Props {
  name: "rocket" | "spark" | "globe" | "grid" | "layout" | "tool";
}
const { name } = Astro.props;

const paths: Record<Props["name"], string> = {
  rocket:
    "M12 2c2.5 2 4 5 4 8.5 0 1.7-.4 3-1 4.2L12 18l-3-3.3c-.6-1.2-1-2.5-1-4.2C8 7 9.5 4 12 2Z M9.5 15.5 7 20l2-1 1-3 M14.5 15.5 17 20l-2-1-1-3 M12 8.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z",
  spark:
    "M12 3v4M12 17v4M4.5 12H3M21 12h-1.5M6 6l1.5 1.5M16.5 16.5 18 18M6 18l1.5-1.5M16.5 7.5 18 6",
  globe:
    "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3.5 12h17 M12 3c2.2 2.4 3.4 5.6 3.4 9s-1.2 6.6-3.4 9c-2.2-2.4-3.4-5.6-3.4-9S9.8 5.4 12 3Z",
  grid: "M4 4h6v6H4V4Z M14 4h6v6h-6V4Z M4 14h6v6H4v-6Z M14 14h6v6h-6v-6Z",
  layout: "M4 4h16v4H4V4Z M4 11h7v9H4v-9Z M13 11h7v9h-7v-9Z",
  tool: "M14.5 3.5a4.5 4.5 0 0 0-5.9 5.9L3 15v3.5h3.5l5.6-5.6a4.5 4.5 0 0 0 5.9-5.9l-2.6 2.6-2-2 2.6-2.6Z",
};
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>

<style>
  .icon {
    width: 26px;
    height: 26px;
    color: var(--accent-strong);
  }
</style>
