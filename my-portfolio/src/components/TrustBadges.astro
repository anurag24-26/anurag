---
import { trustItems } from "../data/site";
---

<section class="trust" aria-label="Credibility">
  <div class="container">
    <div class="trust-row reveal">
      {trustItems.map((item) => (
        <div class="trust-item">
          <span class="trust-label">{item.label}</span>
          <span class="trust-sub dim mono">{item.sub}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    min-width: 130px;
  }

  .trust-label {
    font-weight: 500;
    font-size: 0.95rem;
  }

  .trust-sub {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
</style>
